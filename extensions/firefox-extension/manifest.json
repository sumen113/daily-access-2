{
  "manifest_version": 3,
  "name": "Daily Access 2",
  "version": "1.1.0",
  "description": "The better daily access",
  "content_scripts": [
    {
      "matches": [
        "https://da.gihs.sa.edu.au/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "daily-access-2@gihs.sa.edu.au",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
